MONGODB_URI=mongodb://localhost:27017/sales-invoice
# Optional: 24-char hex ObjectId for this deployment’s workspace (defaults to a fixed single-tenant id if unset)
# WORKSPACE_ID=000000000000000000000001
# Optional: when pdf text is short or regex parse fails
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# tesseract | openai | none (none = pdf-parse + regex only)
OCR_PROVIDER=none
